class Solution {
public:
    string sortSentence(string s) {
        vector<string> words(10);
        string temp = "";

        // Split sentence and place words directly
        for (char ch : s) {
            if (ch == ' ') {
                int pos = temp.back() - '0';
                temp.pop_back();
                words[pos] = temp;
                temp = "";
            } else {
                temp += ch;
            }
        }

        // Process last word
        int pos = temp.back() - '0';
        temp.pop_back();
        words[pos] = temp;

        string ans = "";

        for (int i = 1; i <= 9; i++) {
            if (words[i] != "") {
                if (!ans.empty())
                    ans += " ";
                ans += words[i];
            }
        }

        return ans;
    }
};
