class Solution {
public:
    ListNode* removeElements(ListNode* head, int value) {

        while(head != NULL && head->val == value){
            head = head->next;
        }

        if(head == NULL){
            return NULL;
        }

        ListNode* temp = head;

        while(temp != NULL && temp->next != NULL){

            if(temp->next->val == value){
                temp->next = temp->next->next;
            }
            else{
                temp = temp->next;
            }
        }

        return head;
    }
};
