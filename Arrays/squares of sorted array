class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        vector<int>ans;
        int left=0,right=nums.size()-1;
        while(left<=right){
           if(left!=right){ 
            ans.push_back((long long)nums[left]*nums[left]);
             ans.push_back((long long)nums[right]*nums[right]);
           }
           else{
             ans.push_back((long long)nums[left]*nums[left]);
           }
           left++;
           right--;
        } sort(ans.begin(), ans.end());
        return ans;
    }
};
