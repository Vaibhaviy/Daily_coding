class Solution {
public:
    int celebrity(vector<vector<int>>& knows) {
        int n = knows.size();
        int candidate = 0;

        
        for (int i = 1; i < n; i++) {
            if (knows[candidate][i] == 1) {
                candidate = i;
            }
        }
        for (int i = 0; i < n; i++) {
            if (i != candidate) {
                if (knows[candidate][i] == 1 || knows[i][candidate] == 0) {
                    return -1;
            }
            }
        }

        return candidate;
    }
};
