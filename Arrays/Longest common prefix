class Solution {
public:
    string longestCommonPrefix(vector<string>& Arr) {
         int n=Arr.size();
    if(Arr.empty()){ 
       
        return "";}
    
    string prefix=Arr[0];
    for(int i=0;i<n;i++){
        while(Arr[i].find(prefix)!=0){
            prefix=prefix.substr(0,prefix.length()-1);
            if(prefix.empty()){
                return "";
            }
        }
    }
    return prefix;
}

    };
