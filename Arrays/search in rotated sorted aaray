class Solution {
public:
    int search(vector<int>& Arr, int target) {
        int st=0,end=Arr.size()-1;
        while(st<=end){
            int mid=st+(end-st)/2;
            if(Arr[mid]==target){
                return mid;
            }

            if(Arr[st]<=Arr[mid]){
                if(Arr[st]<=target && target<=Arr[mid]){
                    end=mid-1;
                }else{
                    st=mid+1;
                }
            }else{
                if(Arr[mid]<=target && target<=Arr[end]){
                    st=mid+1;
                }else{
                    end=mid-1;
                }
            }
        }
      return -1;   
    }
};
