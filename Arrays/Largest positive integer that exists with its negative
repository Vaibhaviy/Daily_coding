class Solution {
public:
    int findMaxK(vector<int>& nums) {
       sort(nums.begin(),nums.end());
       int left=0,right=nums.size()-1;
    int largest=-1;
       while(left<right){
        if(nums[right] == -nums[left]){
        largest= nums[right];
        return largest;
        }
        else if(nums[right] > -nums[left]){
            right--;
        }
         else if(nums[right] < -nums[left]){
        left++;
        }
       } 
       return -1;
    }
};
