class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {

        vector<int> ans;
        int count = 0;

        for (int i = 0; i < nums.size(); i++) {

            if (nums[i] == 1)
                count++;
            else {
                ans.push_back(count);
                count = 0;
            }
        }

        // Store the last sequence of 1s
        ans.push_back(count);

        return *max_element(ans.begin(), ans.end());
    }
};
