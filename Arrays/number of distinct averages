class Solution {
public:
    int distinctAverages(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        int left=0,right=nums.size()-1;
        set<float>s;

        while(left<right){
        float  average=(nums[right]+nums[left])/2.0;
        s.insert(average);
    
        left++;
        right--;
        }
        return s.size();
        
    }
};
