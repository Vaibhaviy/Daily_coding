class Solution {
public:
    int countHillValley(vector<int>& nums) {
        int count = 0;
        int prev = nums[0];   // last non-equal element

        for(int i = 1; i < nums.size()-1; i++) {

            if(nums[i] == prev)
                continue;

            int j = i + 1;

            while(j < nums.size() && nums[j] == nums[i])
                j++;

            if(j == nums.size())
                break;

            if((nums[i] > prev && nums[i] > nums[j]) ||
               (nums[i] < prev && nums[i] < nums[j])) {
                count++;
            }

            prev = nums[i];
        }

        return count;
    }
};
