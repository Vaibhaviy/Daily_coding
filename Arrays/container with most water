class Solution {
public:
    int maxArea(vector<int>& height) {
        int n=height.size();
        int left=0,right=n-1,ans=0;
        while(left<right){
            int width=right-left;
            int ht=min(height[left],height[right]);
            int curr_ans=width*ht;
            ans=max(curr_ans,ans);

            height[left] < height[right]? left++ :right--;
        }
       return ans; 
    }
};
