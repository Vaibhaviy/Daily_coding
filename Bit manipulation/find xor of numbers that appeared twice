class Solution {
public:
    int duplicateNumbersXOR(vector<int>& nums) {
        unordered_map<int, int> freq;

    for(int i = 0; i < nums.size(); i++) {
        freq[nums[i]]++;   // store frequency
    }

    int ans = 0;

    for(auto var : freq) {
        if(var.second == 2) {
            ans = ans ^ var.first;
        }
    }

    return ans;
    }
};
